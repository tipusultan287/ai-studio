# Runware API key (https://my.runware.ai/keys). You can also paste it in the app: Settings → Runware API key.
EXPO_PUBLIC_RUNWARE_API_KEY=
# Optional: route all Runware calls through your own backend so the key never ships in the app.
# The proxy must accept the same JSON task array and forward it to https://api.runware.ai/v1 with the key.
EXPO_PUBLIC_RUNWARE_PROXY_URL=
