{
  "expo": {
    "name": "AI Studio",
    "slug": "ai-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aistudio",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.zehnify.aistudio",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "AI Studio needs access to your photos and videos to edit them.",
        "NSPhotoLibraryAddUsageDescription": "AI Studio saves your creations to your photo library.",
        "NSCameraUsageDescription": "AI Studio uses the camera to capture photos and videos to edit.",
        "NSMicrophoneUsageDescription": "AI Studio uses the microphone to record audio and video."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.zehnify.aistudio",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "AI Studio uses the microphone to record audio."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AI Studio needs access to your photos and videos to edit them.",
          "cameraPermission": "AI Studio uses the camera to capture media.",
          "microphonePermission": "AI Studio records audio with video."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "AI Studio needs access to your photos.",
          "savePhotosPermission": "AI Studio saves your creations to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "ffmpeg-expo",
        {
          "includeX86": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#09090C"
  }
}